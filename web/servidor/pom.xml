<?xml version="1.0" encoding="UTF-8"?>
<!-- ======================================================================
     SERVIDOR: aplicación web completa en un solo ejecutable.
       Spring Boot  -> levanta el servidor y conecta la base de datos.
       Spring Data  -> guarda/lee sin escribir SQL (solo interfaces).
       Vaadin       -> pantallas escritas en Java puro (sin HTML/JS).
       SQLite       -> base de datos en UN archivo (mercado.db).
       Hibernate    -> crea las tablas solo a partir de las clases.
     Para correr:  mvn spring-boot:run   (luego abrir http://localhost:8080)
     ====================================================================== -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>bo.umss.mercado</groupId>
  <artifactId>mercado-servidor</artifactId>
  <version>1.0.0</version>
  <name>Mercado UMSS - Servidor web</name>

  <properties>
    <java.version>17</java.version>
    <!-- Vaadin 24.6: pantallas 100% Java, sin HTML ni JavaScript -->
    <vaadin.version>24.6.13</vaadin.version>
    <!-- Dialecto SQLite EXACTO de la línea Hibernate que trae Boot 3.3 -->
    <version.hibernate-dialectos>6.5.3.Final</version.hibernate-dialectos>
    
    <!-- Exportación profesional -->
    <version.poi>5.2.5</version.poi>
    <version.openpdf>2.0.3</version.openpdf>
    <version.batik>1.17</version.batik>
    
    <!-- SOLUCIÓN AL ERROR DE RENDER: Forzar versión de commons-io -->
    <version.commons-io>2.20.0</version.commons-io>
  </properties>

  <dependencies>
    <!-- El núcleo de análisis (nuestro otro módulo) -->
    <dependency>
      <groupId>bo.umss.mercado</groupId>
      <artifactId>mercado-nucleo</artifactId>
      <version>1.0.0</version>
    </dependency>

    <!-- Vaadin: componentes web programados en Java -->
    <dependency>
      <groupId>com.vaadin</groupId>
      <artifactId>vaadin-spring-boot-starter</artifactId>
      <version>${vaadin.version}</version>
    </dependency>

    <!-- JPA: guardar objetos Java sin escribir SQL -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- SQLite: base de datos en un archivo (mercado.db) -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.53.4.0</version>
    </dependency>

    <!-- Traductor Hibernate<->SQLite (lo pide JPA para crear tablas) -->
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-community-dialects</artifactId>
      <version>${version.hibernate-dialectos}</version>
    </dependency>

    <!-- SOLUCIÓN AL ERROR DE RENDER: Fuerza commons-io 2.20.0 para commons-csv 1.14.1 -->
    <dependency>
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
      <version>${version.commons-io}</version>
    </dependency>

    <!-- Exportación profesional: Excel .xlsx multi-hoja -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>${version.poi}</version>
    </dependency>

    <!-- Exportación profesional: PDF ejecutivo -->
    <dependency>
      <groupId>com.github.librepdf</groupId>
      <artifactId>openpdf</artifactId>
      <version>${version.openpdf}</version>
    </dependency>

    <!-- Batik: convierte SVG de GraficoCanvas a PNG para el PDF -->
    <dependency>
      <groupId>org.apache.xmlgraphics</groupId>
      <artifactId>batik-transcoder</artifactId>
      <version>${version.batik}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.xmlgraphics</groupId>
      <artifactId>batik-codec</artifactId>
      <version>${version.batik}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Empaqueta todo (servidor + web + base de datos) en un .jar -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- Compila la parte visual de Vaadin (descarga Node.js solo) -->
      <plugin>
        <groupId>com.vaadin</groupId>
        <artifactId>vaadin-maven-plugin</artifactId>
        <version>${vaadin.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>prepare-frontend</goal>
              <goal>build-frontend</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>